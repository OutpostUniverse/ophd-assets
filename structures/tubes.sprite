<sprite version="0.99">
	<imagesheet id="main" src="tubes.png" />

	<action name="intersection">
		<frame sheetid="main" x="0" y="0" width="128" height="64" anchorx="0" anchory="0" />
	</action>

	<action name="right">
		<frame sheetid="main" x="128" y="0" width="128" height="64" anchorx="0" anchory="0" />
	</action>

	<action name="left">
		<frame sheetid="main" x="256" y="0" width="128" height="64" anchorx="0" anchory="0" />
	</action>
</sprite>